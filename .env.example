# LLM Configuration (Optional - Local deterministic grounded generator is used if no key is provided)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# System Settings
BRAND_NAME=AppleSupport
DATA_PATH=data/sample_twcs.csv
DB_PATH=data/conversations.db
FAISS_INDEX_PATH=data/faiss_index.bin
GOLDEN_SET_PATH=data/golden_set.json
LOG_LEVEL=INFO

# Confidence & Escalation Thresholds
INTENT_CONFIDENCE_THRESHOLD=0.65
RETRIEVAL_SIMILARITY_THRESHOLD=0.60
GROUNDING_THRESHOLD=0.70
